<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_primary"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fake GPS · Shizuku"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="No root: grants mock_location automatically via Shizuku"
                android:textColor="#C5CAE9"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 步骤 1：Shizuku 状态 -->
        <TextView
            style="@style/CardTitle"
            android:text="① Shizuku status" />

        <TextView
            android:id="@+id/tvShizukuStatus"
            style="@style/CardBody"
            android:text="Checking..." />

        <LinearLayout style="@style/RowButtons">

            <Button
                android:id="@+id/btnShizukuPermit"
                style="@style/PrimaryBtn"
                android:layout_weight="2"
                android:text="Request Shizuku permission" />

            <Button
                android:id="@+id/btnInstallShizuku"
                style="@style/SecondaryBtn"
                android:layout_weight="1"
                android:text="Install Shizuku"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 步骤 2：mock_location AppOps -->
        <TextView
            style="@style/CardTitle"
            android:text="② Mock location permission" />

        <TextView
            android:id="@+id/tvMockOpsStatus"
            style="@style/CardBody"
            android:text="mock_location status: -" />

        <LinearLayout style="@style/RowButtons">

            <Button
                android:id="@+id/btnGrantMock"
                style="@style/PrimaryBtn"
                android:layout_weight="2"
                android:text="Grant mock_location via Shizuku" />

            <Button
                android:id="@+id/btnOpenDevSettings"
                style="@style/SecondaryBtn"
                android:layout_weight="1"
                android:text="Developer options" />
        </LinearLayout>

        <LinearLayout style="@style/RowButtons">

            <Button
                android:id="@+id/btnEnableLocation"
                style="@style/PrimaryBtn"
                android:layout_weight="2"
                android:backgroundTint="#FB8C00"
                android:text="Turn on system Location via Shizuku" />

            <Button
                android:id="@+id/btnDiagnose"
                style="@style/SecondaryBtn"
                android:layout_weight="1"
                android:text="Diagnostics" />
        </LinearLayout>

        <!-- 步骤 3：坐标 -->
        <TextView
            style="@style/CardTitle"
            android:text="③ Set fake coordinates" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preset places"
                android:textColor="#666666"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latitude (lat)"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etLat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="39.908823"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp"
                        android:autofillHints="" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Longitude (lng)"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etLng"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="116.397470"
                        android:inputType="numberSigned|numberDecimal"
                        android:textSize="14sp"
                        android:autofillHints="" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Accuracy (m)"
                android:textColor="#666666"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAccuracy"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:hint="1.0"
                android:inputType="numberDecimal"
                android:textSize="14sp"
                android:autofillHints="" />

        </LinearLayout>

        <!-- 步骤 4：启停 -->
        <TextView
            style="@style/CardTitle"
            android:text="④ Start / Stop" />

        <TextView
            android:id="@+id/tvRunStatus"
            style="@style/CardBody"
            android:text="○ Stopped" />

        <LinearLayout style="@style/RowButtons">

            <Button
                android:id="@+id/btnStart"
                style="@style/PrimaryBtn"
                android:layout_weight="1"
                android:backgroundTint="#00897B"
                android:text="Start fake location" />

            <Button
                android:id="@+id/btnStop"
                style="@style/SecondaryBtn"
                android:layout_weight="1"
                android:backgroundTint="#E53935"
                android:text="Stop" />
        </LinearLayout>

        <!-- 步骤 5：高德/百度网络定位拦截（VpnService DNS 黑洞） -->
        <TextView
            style="@style/CardTitle"
            android:text="⑤ Amap/Baidu network-location block (other traffic unaffected)" />

        <TextView
            android:id="@+id/tvFenceStatus"
            style="@style/CardBody"
            android:text="○ GPS fence off" />

        <LinearLayout style="@style/RowButtons">

            <Button
                android:id="@+id/btnFenceToggle"
                style="@style/PrimaryBtn"
                android:layout_weight="1"
                android:backgroundTint="#7E57C2"
                android:text="Start GPS fence (block Amap/Baidu network location)" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="How to use:\n① → ② (green) → ② (orange: turn on location) → ③ → ④ Start fake location → ⑤ Start GPS fence\n\nAbout ⑤ GPS fence:\n• Only blocks the DNS lookups of the Amap/Baidu network-location APIs, so their network location fails and they fall back to GPS (= our fake location)\n• Map tiles, search, navigation and other apps are not affected\n• On start, Android asks “Allow VPN?”. Tap OK (standard VpnService flow, no data is uploaded)\n• A key icon in the status bar shows the VPN is running\n\nDetection notes:\n• Other apps may still see isFromMockProvider() = true (system flag). Hiding it fully needs Root/Xposed\n• If an app bypasses DNS (direct IP or DoH), the fence does not work for it"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
